# Server Configuration
ADDR=:8080
ENV=development
VERSION=0.0.1
CORS_ALLOWED_ORIGIN=http://localhost:5174

# Database Configuration (PostgreSQL)
DB_ADDR=postgres://username:password@localhost:5432/social?sslmode=disable
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=30
DB_MAX_IDLE_TIME=15m

# Cache Configuration (Redis)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLE=false

# Authentication Configuration (JWT)
JWT_SECRET=your-super-secure-jwt-secret-key
JWT_AUD=go-social
JWT_ISS=go-social

# Rate Limiter Configuration
RATE_LIMITER_ENABLED=true
RATELIMITER_REQUESTS_COUNT=20

# Email Integration (SendGrid)
SEND_GRID_API_KEY=your-sendgrid-api-key
SEND_GRID_FROM_EMAIL=noreply@example.com

# Email Integration (Mailtrap SMTP)
MAIL_TRAP_API_KEY=your-mailtrap-api-key
MAIL_TRAP_FROM_EMAIL=noreply@example.com
